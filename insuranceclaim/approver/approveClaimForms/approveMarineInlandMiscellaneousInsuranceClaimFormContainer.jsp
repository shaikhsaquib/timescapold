	{
		String claimRequestDetail[] = (String[]) marineClaimDetails.get(i);

		Hashtable marineClaimDetailHash = xmlObj.readSubNode(claimRequestDetail[2],"marineClaimForm");
//		System.out.println(marineClaimDetailHash); 

