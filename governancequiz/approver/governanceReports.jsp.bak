  </tr>
  
    </table>
	<div style="height:275px; overflow:scroll">
    <table width="100%" border="0" cellpadding="0" cellspacing="1" bordercolor="#FFFFFF">
<%		
        int counter = 0;
        String[] deptArr = new String[50];
        String[] totalArr = new String[50];
        String[] attemptedArr = new String[50];
        String[] passArr = new String[50];
        String[] failArr = new String[50];

			for(int j=0;j<totalReport.size();j++) 
			{      
                tmpArr = (String[])totalReport.get(j);
                passStatus = tmpArr[1];
                //System.out.println("====="+deptnm);
                if(passStatus==null && !(deptnm.equals(tmpArr[0]))){      
                    totalCount = Integer.parseInt(tmpArr[3]);
                    attemptedCount = 0;
                    passCount = 0;
                    failCount = 0;                    
                    counter += 1; 
                    deptnm = tmpArr[0];
                    deptArr[counter] = deptnm;
                    totalArr[counter] = Integer.toString(totalCount);  
                    attemptedArr[counter] = Integer.toString(attemptedCount);  
                    passArr[counter] = Integer.toString(passCount);  
                    failArr[counter] = Integer.toString(failCount);
                }                
                else if("F".equals(passStatus) && !(deptnm.equals(tmpArr[0]))){                   
                    totalCount = Integer.parseInt(tmpArr[3]);
                    attemptedCount =  Integer.parseInt(tmpArr[2]);
                    passCount = 0;
                    failCount =  Integer.parseInt(tmpArr[2]);
                    counter += 1; 
                    deptnm = tmpArr[0];
                    deptArr[counter] = deptnm;
                    totalArr[counter] = Integer.toString(totalCount);  
                    attemptedArr[counter] = Integer.toString(attemptedCount);  
                    passArr[counter] = Integer.toString(passCount);  
                    failArr[counter] = Integer.toString(failCount);
                }
                else if("F".equals(passStatus) && (deptnm.equals(tmpArr[0]))){                      
                    totalCount = totalCount + Integer.parseInt(tmpArr[3]);
                    attemptedCount = attemptedCount +  Integer.parseInt(tmpArr[2]);
                    failCount =  Integer.parseInt(tmpArr[2]);
                    totalArr[counter] = Integer.toString(totalCount);  
                    attemptedArr[counter] = Integer.toString(attemptedCount);  
                    failArr[counter] = Integer.toString(failCount);
                }
               else if("P".equals(passStatus) && (deptnm.equals(tmpArr[0]))){                         
                    totalCount = totalCount + Integer.parseInt(tmpArr[3]);
                    attemptedCount = attemptedCount +  Integer.parseInt(tmpArr[2]);
                    passCount =  Integer.parseInt(tmpArr[2]);
                    totalArr[counter] = Integer.toString(totalCount);  
                    attemptedArr[counter] = Integer.toString(attemptedCount);  
                    passArr[counter] = Integer.toString(passCount);  
                }
                else if("P".equals(passStatus) && !(deptnm.equals(tmpArr[0]))){                         
                    totalCount = Integer.parseInt(tmpArr[3]);
                    attemptedCount =  Integer.parseInt(tmpArr[2]);
                    passCount =  Integer.parseInt(tmpArr[2]);
                    failCount = 0;
                    counter += 1; 
                    deptnm = tmpArr[0];
                    deptArr[counter] = deptnm;
                    totalArr[counter] = Integer.toString(totalCount);  
                    attemptedArr[counter] = Integer.toString(attemptedCount);  
                    passArr[counter] = Integer.toString(passCount);  
                    failArr[counter] = Integer.toString(failCount);
                }
                else  if(passStatus==null && (deptnm.equals(tmpArr[0]))){      
                    totalCount = totalCount + Integer.parseInt(tmpArr[3]);
                    totalArr[counter] = Integer.toString(totalCount);  
                }
            }
            for(int k=1;k<counter+1;k++) 
			{
                //System.out.println(deptArr[k]+","+totalArr[k]+","+attemptedArr[k]+","+passArr[k]+","+failArr[k]);
                
%>
                 <tr>
                    <td width="20%" height="26" align="left" valign="middle" bgcolor="#f6f6f6" class="style3"> <%=deptArr[k]%></td>
                    <td width="20%" height="26" align="right" valign="middle" bgcolor="#f6f6f6" class="style3"><%=totalArr[k]%></td>
                    <td width="21%" align="right" valign="middle" bgcolor="#f6f6f6" class="style3"> <%=attemptedArr[k]%></td>
<%
                if("0".equals(passArr[k])){
                
%>                
                    <td width="20%" align="right" valign="middle" bgcolor="#f6f6f6" class="style3"><%=passArr[k]%></td>
<%
                }else if(!("0".equals(passArr[k]))){
%>                
                    <td width="20%" align="right" valign="middle" bgcolor="#f6f6f6" class="style3"><a href="javascript:viewDetail(1,'<%=deptArr[k]%>')"><font color = "grey"><%=passArr[k]%></a></td>
<%
                }
                if("0".equals(failArr[k])){                
%>                
                    <td width="20%" align="right" valign="middle" bgcolor="#f6f6f6" class="style3"><%=failArr[k]%></td>
<%
                }else if(!("0".equals(failArr[k]))){
%>                
                    <td width="20%" align="right" valign="middle" bgcolor="#f6f6f6" class="style3"><a href="javascript:viewDetail(0,'<%=deptArr[k]%>')"><font color = "grey"><%=failArr[k]%></a></td>
<%
                }

            }
%>
   
