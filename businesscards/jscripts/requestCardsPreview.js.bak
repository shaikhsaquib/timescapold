function showCardDesign(firstName,lastName,designation,activityName,addressLine1,addressLine2,directPhoneNo,fax,mobileNumber,userBoardNumber,extensionNumber,workArea,compName,website){
	frmObj = document.frmPreview;

	cardTemplate = frmObj.cardTemplate.value;
    //alert(cardTemplate);     
	stat = checkNull("Card Template ", cardTemplate);
	if(!stat){
		frmObj.cardTemplate.focus();
		return;
	}
	if (cardTemplate == "NBTL")
	{
		//alert(cardTemplate);

      document.getElementById("add").style.display = "";
	}
	else
	{
		document.getElementById("add").style.display = "none";
	}
 //alert('../includes/cardTemplate.jsp?cardTemplate='+cardTemplate+'&firstName='+firstName+'&lastName='+lastName+'&designation='+designation+'&activityName='+activityName+'&addressLine1='+addressLine1+'&addressLine2='+addressLine2+'&directPhoneNo='+directPhoneNo+'&fax='+fax+'&mobileNumber='+mobileNumber+'&userBoardNumber='+userBoardNumber+'&extensionNumber='+extensionNumber+'&workArea='+workArea+'&compName='+compName+'&website='+website);  
	 loadFragment('../includes/cardTemplate.jsp?cardTemplate='+cardTemplate+'&firstName='+firstName+'&lastName='+lastName+'&designation='+designation+'&activityName='+activityName+'&addressLine1='+addressLine1+'&addressLine2='+addressLine2+'&directPhoneNo='+directPhoneNo+'&fax='+fax+'&mobileNumber='+mobileNumber+'&userBoardNumber='+userBoardNumber+'&extensionNumber='+extensionNumber+'&workArea='+workArea+'&compName='+compName+'&website='+website,'Card-Area','Business Card');

	if (cardTemplate == "TCLL" || cardTemplate == "TCL" || cardTemplate == "TML" || cardTemplate == "TMDT")
	{ 
		document.getElementById("CardBack-Area-Default").style.display = "";
		loadFragment('../includes/default.jsp?cardTemplate='+cardTemplate+'&addressLine1='+addressLine1+'&addressLine2='+addressLine2+'&directPhoneNo='+directPhoneNo+'&fax='+fax+'&userBoardNumber='+userBoardNumber+'&extensionNumber='+extensionNumber+'&website='+website,'CardBack-Area-Default','Business Card');
	}

}

function loadFragment(fragment_url, element_id, for_what){
    var xmlhttp = "";
    if (window.XMLHttpRequest){
        // code for Mozilla, etc.
        xmlhttp=new XMLHttpRequest();
    }else if (window.ActiveXObject){ 
        // code for IE
        xmlhttp=new ActiveXObject("Microsoft.XMLHTTP");
    }else{
        alert("Sorry Your Browser is not Supported");
    }
    
    var element = document.getElementById(element_id);
    
    var message = "";
    var processingRequest='<table width="100%" border="1"><tr><td align="center"><img src="../images/loading.gif" valign="absmiddle">&nbsp;&nbsp;'+for_what+' Loading...</td></tr></table>';
        
    element.innerHTML = processingRequest;

    try{
        xmlhttp.open("GET", fragment_url);
        xmlhttp.onreadystatechange = function(){

            if (xmlhttp.readyState == 4 && xmlhttp.status == 200){
                var gotresponse	=	xmlhttp.responseText;
                
				message =  gotresponse;
                   
                element.innerHTML = message;
             }
		}
		xmlhttp.send(null);
	 }// display an error in case of failure
	 catch (e){
	  alert("Can't connect to server:\n" + e.toString());
	 }
}

