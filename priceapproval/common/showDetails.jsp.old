      <tr>
        <td height="22" bgcolor="#ffffff" class="travelMenuBG">APPROVALS</td>
        </tr>
    </table>
      <table width="100%" cellspacing="2" cellpadding="2">
        <tr class="greyBG">
          <td width="17%" >B&amp;C-<span class="small"> LEVEL 1</span><span class="redsmall"></span></td>
          <td width="17%" height="29" >USER/ TEAM<span class="small">-LEVEL </span><span class="redsmall"><span class="small">1</span></span></td>
