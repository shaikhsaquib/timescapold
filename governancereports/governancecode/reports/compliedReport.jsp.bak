<%@ page language="java" %>
<%@ include file="../includes/sessionCheck.jsp" %>
<%//@ page errorPage="../common/errorPage.jsp"%>
<%@ include file="../includes/empHeader.jsp" %>
<%@ page import="java.util.Hashtable, java.util.ArrayList"%>
<%@ page import="java.text.*, java.util.Calendar, java.util.GregorianCalendar, java.util.Date" %>
<%@ page import="java.util.Hashtable, java.util.ArrayList"%>
<%@ page import="com.bccl.util.HtmlUtil,com.bccl.util.Utility,com.bccl.util.SQLUtility"%>
<jsp:useBean id="governanceReviewerController"class="com.bccl.governancecode.web.controllerbeans.GovernanceReviewerWebController" />

<%	
	String compCode = (String) request.getParameter("compCode");
	String function = (String) request.getParameter("Function");
	String prevYear = (String) request.getParameter("prevYear");
	String currYear = "2011";//(String) request.getParameter("currYear");
	String criteria = (String) request.getParameter("criteria");
	String userCompliance = (String) request.getParameter("userCompliance");
	long apprOId    = Long.parseLong((String) request.getParameter("apprOId"));
	
	ArrayList reviewerResult = new ArrayList(); 

	int colorCnt = 0;
	String bgColor = "";
	
	reviewerResult = governanceReviewerController.getCompliedReport(criteria, userCompliance , prevYear, apprOId, compCode, function);
	//out.println("reviewerResult :" + reviewerResult.size());

	String roleCode= "3";
	String userName = "";
	String reportTitle = "";
	if ("Y".equals(userCompliance))
	{
		reportTitle = "Complied Report";
	}else if ("N".equals(userCompliance))
	{
		reportTitle = "Not Complied Report";
	}
%>

<html>

	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
		<title>Governance Code Report</title>
		<link href="../style/governance.css" rel="stylesheet" type="text/css" />
	<style type="text/css">
		<!--
		body {
		margin-left: 0px;
		margin-top: 0px;
		margin-right: 0px;
		margin-bottom: 0px;
		}
		-->
	</style>
		<link href="../style/governance.css" rel="stylesheet" type="text/css" />
		<script Language="JavaScript" src="../jscripts/savechklist.js"></script>
		<script Language="JavaScript" src="../jscripts/report.js"></script>
		<script Language="JavaScript" src="../jscripts/common.js"></script>
	</head>


			<body>
			<form name="frmSaveChklist" method = "post" action = "">

				
					<%@ include file="../includes/headerMenu.jsp"%>
					<table width="100%" border="0" cellspacing="0" cellpadding="0">
						
						<tr>
							<td align = "left" class = "style2"><%=reportTitle%></td>
						</tr>
						<tr>
						<td width = "50%" height="10" align="left" valign="middle" class="style1" colspan="10"><div align="left"><span class="menu2"><!--  From  01-01-2011 to 31-12-2011  --></span></div></td>
							<!-- <td width="72%" colspan="3" align="right" valign="middle" class="style1"><a href="#" onclick="downloadReportComplied('<%=compCode%>', '<%=function%>','<%=prevYear%>','<%=apprOId%>','<%=criteria%>','<%=userCompliance%>')"	class="normal">Download All</a></td> -->
							<td width="100%" colspan="0" align="right" class="normal"><a href="#" onclick="downloadReportComplied('<%=compCode%>', '<%=function%>','<%=prevYear%>','<%=apprOId%>','<%=criteria%>','<%=userCompliance%>')"><img src="../images/excel.png" border="0"  class="normal" align="right"></a>Download</td>

							</tr>
	 
						
						<tr><td align = "right">
						
							</td>
							</tr> 

					</table>
					

		<table width="100%" border="0" cellpadding="1" cellspacing="1" bordercolor="#FFFFFF">

<%

		if (reviewerResult.size() > 0){
%>


				<tr class="travelMenuBG"> 
					<td width="30%" align="left" valign="middle"  class="travelMenuBG">POLICY HEAD</td>
					<td width="30%" align="left" valign="middle"  class="travelMenuBG">POLICY</td>
					<td width="20%" align="left" valign="middle"  class="travelMenuBG">USER FEEDBACK</td>
					<td width="20%" align="left" valign="middle"  class="travelMenuBG">USER REMARKS</td>
				</tr>
	</table>
	<div style="height:180px; overflow:scroll">
	<table width="100%" border="0" cellpadding="1" cellspacing="1" bordercolor="#FFFFFF">
<%		
		
		
				for(int i=0;i<reviewerResult.size();i++) {	
				String[] tmpArr = (String [] )reviewerResult.get(i);

					if(!userName.equals(tmpArr[5])) {
						userName = tmpArr[5];
%>
						<tr class="greyBG">
							<td  height = "30" width="15%" align="left" valign="middle" class="greyBG" colspan = "100%"><b><%=tmpArr[1]%> / <%=tmpArr[5]%></b></td>
						</tr>
<%		
					}

%>	
				    <tr <%if((i%2)==0){%>bgcolor="#f8f8f8"<%}%>>	

					<td bgcolor="<%=bgColor%>" width="30%" align="left" valign="middle" class="style3"><%=tmpArr[0]%> </td>
					<td bgcolor="<%=bgColor%>" width="31%" align="left" valign="middle" class="style3"><%=tmpArr[2]%></td>
					<td bgcolor="<%=bgColor%>" width="21%" align="left" valign="middle" class="style3"><%=tmpArr[3]%></td>
					<td bgcolor="<%=bgColor%>" width="18%" align="left" valign="middle" class="style3"><%=tmpArr[4]%></td>

<%							
				}
		
	} 

	else{

%>

				<table width="100%" >
					<tr>
						<td bgcolor="#f8f8f8" width="46%" align="center" valign="middle" class="style3">There are no records available for the selected criteria!!!</td>
					</tr>
				</table>
<%
	}
%>				
		</table>
	</div>
			<table width="100%" border="0" cellspacing="0" cellpadding="0">
				<tr>
					   <td colspan="3" class="normal" height="30px">&nbsp;
					   </td>
					</tr>
					<tr bgcolor="#FFFFFF">
					   <td colspan="100" align="center" class="normal">&nbsp;
						  <input type="button" name="Return" value="Return" onclick="javascript:history.go(-1)">
					   </td>
					</tr>

				  <tr>
					<td colspan="100%" height="3px" ><block type="spacer" height="1px"></td>
				  </tr>

				</table>
			<p>&nbsp;</p>

	</body>
</html>