					<td width="27%" align="left" valign="middle" bgcolor="#74CAD3" class="style1">CONTROLS</td>
                    <td width="10%" align="left" valign="middle" bgcolor="#74CAD3" class="style1">CURRENT YEAR FEEDBACK</td>
					<td width="15%" align="left" valign="middle" bgcolor="#74CAD3" class="style1">USER REMARKS</td>
					<td width="15%" align="left" valign="middle" bgcolor="#74CAD3" class="style1">APPROVER REMARKS</td>
					<td width="15%" align="left" valign="middle" bgcolor="#74CAD3" class="style1">OVERRIDDEN REMARKS</td>					
					<td width="10%" align="left" valign="middle" bgcolor="#74CAD3" class="style1">LAST YEAR FEEDBACK</td>

				</tr>
	</table>
	<div style="height:180px; overflow:scroll">
	<table width="100%" border="0" cellspacing="0" cellpadding="0">
<%		
		int cnt = 0; 
		String userName = "";
		String userFeedback = "";
		String lstYearFdbk = "";
		String emailid = "";
		String chklist = "";
		String fromDate ="";
		String toDate ="";
		String userRemarks ="";
		String approverRemarks ="";
		String overriddenRemarks ="";
		//String userComplianceStatus ="";
	for(int i=0;i<reviewerResult.size();i++) {	
		cnt = i;
		String[] tmpArr = (String [] )reviewerResult.get(i);

		userFeedback = (String)tmpArr[2];
		emailid = (String)tmpArr[15];
		chklist = (String)tmpArr[1];
		fromDate = (String)tmpArr[5];
		toDate = (String)tmpArr[6];
		userRemarks = (String)tmpArr[3];
		approverRemarks = (String)tmpArr[20];
		overriddenRemarks = (String)tmpArr[21];

	if(!userName.equals(tmpArr[12])) {
		userName = tmpArr[12];
%>
				<tr>
					<td bgcolor="#C0C0C0" height = "30" width="15%" align="left" valign="middle" class="style2" colspan = "100%"> <b><%=tmpArr[12]%>&nbsp;&nbsp;/&nbsp;&nbsp;<%=tmpArr[17]%></b></td>
				</tr>
<%		
	}
%>	
				<tr>	
					<td bgcolor="#f8f8f8" width="18%" align="left" valign="middle" class="style3"><%=tmpArr[16]%> </td>
					<td bgcolor="#f8f8f8" width="27%" align="left" valign="middle" class="style3"><%=tmpArr[1]%> </td>
					<td bgcolor="#f8f8f8" width="10%" align="left" valign="middle" class="style3"><%=tmpArr[2]%></td>
					<td bgcolor="#f8f8f8" width="15%" align="left" valign="middle" class="style3"><%=tmpArr[3]%></td>
					<td bgcolor="#f8f8f8" width="15%" align="left" valign="middle" class="style3"><%=tmpArr[20]%></td>					
					<td bgcolor="#f8f8f8" width="15%" align="left" valign="middle" class="style3"><%=tmpArr[21]%></td>
                    <td bgcolor="#f8f8f8" width="10%" align="left" valign="middle" class="style3"><%=tmpArr[26]%></td>
				</tr>
<%		 

		String reportResultArr [] = {tmpArr[16], chklist, tmpArr[12], userRemarks, approverRemarks, overriddenRemarks, userFeedback, tmpArr[26]}; 

		reportResult.put(i+"",reportResultArr);
	}

		session.setAttribute("nonCompliance",reportResult);
	}
	else{
%>
				<table width="100%" >
					<tr>
						<td bgcolor="#f8f8f8" width="46%" align="center" valign="middle" class="style3">There are no records available for the selected criteria!!!</td>
