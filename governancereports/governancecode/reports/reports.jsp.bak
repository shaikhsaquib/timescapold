								<td width="100%" colspan="0" align="right" class="normal"><a href="#" onclick="downloadReportForReviewer(<%=3%>, '<%=criteria%>','<%=prevYear%>','<%=currYear%>')"><img src="../images/excel.png" border="0"  class="normal" align="right"></a>Download</td> 
