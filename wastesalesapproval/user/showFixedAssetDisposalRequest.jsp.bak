	<script>
	$(document).ready(function(){
 		$("#add_row").click(function(){
		var t=0;
		for (var i = 4; i < 8; i++) {	
						
		
			$('#addr'+i).html("<td>"+(i+1)+"</td> <td class='text-center'><div class='form-group ' style='margin-left:5px;margin-right:5px;'><input name='desc"+i+"' id='desc"+i+"' type='text' placeholder='Description' class='form-control charLen' maxlength = '100'  /></div> </td><td class='text-center'><div class='form-group grp has-feedback ' style='margin-left:5px;margin-right:5px;'><input name='quantity"+i+"' id='quantity"+i+"' type='text' placeholder='Qty' class='form-control text-right two-digits only-num charLen' maxlength = '10' /></div> </td><td class='text-center'><div class='form-group' style='margin-left:5px;margin-right:5px;'><select name='uom"+i+"' id='uom"+i+"' placeholder='UOM' class='form-control' style='padding-right:2px;'><%=popupUnit%></select></div></td>  <td class='text-center'><div class='form-group grp has-feedback ' style='margin-left:5px;margin-right:5px;'><input name='valueOfMaterials"+i+"' id='valueOfMaterials"+i+"'  type='text' placeholder='NA' class='form-control text-right two-digits only-num charLen' value='' maxlength = '10' /> </div> </td>  <td class='text-center'><div class='form-group grp has-feedback ' style='margin-left:5px;margin-right:5px;'><input name='finalNegotiatedAmt"+i+"' id='finalNegotiatedAmt"+i+"' type='text' placeholder='' class='form-control text-right two-digits only-num charLen' onblur='javascript:indexCal("+i+")' maxlength = '10' /> </div></td> <td class='text-center'><div class='form-group grp has-feedback ' style='margin-left:5px;margin-right:5px;'><textarea name='finalHighestBidder"+i+"' id='finalHighestBidder"+i+"' placeholder='final Highest Bidder' class='form-control noresize textarea' rows='2' maxlength='100' id='textarea' rel='tooltip' title=''/></textarea></div> </td> <td><div class='form-group  ' style='margin-left:5px;margin-right:5px;'><textarea name='comments"+i+"' id='comments"+i+"' placeholder='Remarks' class='form-control noresize textarea' rows='2' maxlength='255' id='textarea' rel='tooltip' title=''/></textarea> </div></td> ");		
			$('#tab_logic').append('<tr id="addr'+(i+1)+'"></tr>');


			$("#add_row").hide();
			t = i+1;
			};
		//	alert("outside3 loop===="+i)
			$('#tabSize').val(t);

			$('.charLen').each(function () {
			 $(this).maxlength({alwaysShow: true});	
			});

			$("[name^=quantity]").each(function () {
				$(this).rules("add", {
					required: true,
					pattern: /^(?:[1-9]\d*|0)?(?:\.\d+)?$/,
					messages: {
					pattern:  "Valid Format is : 0.00"
				}
					
				});	
			});

			/*$("[name^=valueOfMaterials]").each(function () {
				$(this).rules("add", {
					required: true,
					pattern: /^(?:[1-9]\d*|0)?(?:\.\d+)?$/,
					messages: {
					pattern:  "Valid Format is : 0.00"
				}
					
				});	
			});*/

			$("[name^=finalNegotiatedAmt]").each(function () {
				$(this).rules("add", {
					required: true,
					pattern: /^(?:[1-9]\d*|0)?(?:\.\d+)?$/,
					messages: {
					pattern:  "Valid Format is : 0.00"
				}
					
				});	
			});

			//$( function() {
				$('.two-digits').keyup(function(){
					if($(this).val().indexOf('.')!=-1){         
						if($(this).val().split(".")[1].length > 2){                
							if( isNaN( parseFloat( this.value ) ) ) return;
							this.value = parseFloat(this.value).toFixed(2);
						}  
					 }            
					 return this; //for chaining
				});
			//});

			$('.only-num').keypress(function(event) {

				var val1  = this.value.split('.').length;
				var unicode = event.charCode ? event.charCode : event.keyCode;
				if((unicode == 46) && val1 > 1)
				{
					 return false;
				}
				// here i will get textbox contents and loop through it
				if ((unicode == 8) || (unicode == 9) || (unicode == 45) || (unicode == 46) || (unicode > 47 && unicode < 58) ) {
					return true;
				}
				else {
					return false;
				}

				/*if (((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57) || ((event.which == 46) && val1 > 1))) 
				{
					event.preventDefault();
				}*/
			});

		});

		$("#delete_row").click(function(){
			var val1 = $('#tabSize').val();
			//var x = parseInt(val1)+1;
			var x = parseInt(val1);
			if(x>5){
				//alert("inside delete loop===="+i)

				$("#addr"+(x-1)).html('');
				x--;d

				//$('#tabSize').val(x-1);
				$('#tabSize').val(x);
			}
			$("#add_row").show();
		});
});
</script>

<script>
	$(document).ready(function(){
      var j=1;
    $("#add_row2").click(function(){
		$(".js-example-basic-single").select2({ width: '100%'  });		  

		$('#addr2'+j).html("<td class='text-center'>"+(j+1)+"</td> <td><input type='text' class='form-control charLen'  name='userDeptHead"+j+"' id='userDeptHead"+j+"' maxlength = '100' placeholder='Enter Emailid' onkeyup=\"lookupAll2(this.value,'"+j+"','"+j+"','userEmail');\" /><div class='suggestionsBox' id='suggestions"+j+"' style='display:none;text-align:left;' class='form-control'><div class='suggestionList Breakword' id='autoSuggestionsList"+j+"' style='padding-left:2px;text-align:left;'></div></div></td>");	
			
		$('#tab_logic2').append('<tr id="addr2'+(j+1)+'"></tr>');
		j++; 
		$('#userDeptHeadSize').val(j);
		$(".js-example-basic-single").select2({ width: '100%'  });		
	});
    $("#delete_row2").click(function(){
    	if(j>1){
			$("#addr2"+(j-1)).html('');
			j--;
			$('#userDeptHeadSize').val(j);
		}
	});
	});
	</script>
